# Copy to .env and fill in.  cp env.example .env   (NEVER commit .env)
# --- models (verify ids against provider docs before quoting anywhere) ---
ANTHROPIC_API_KEY=
REDCELL_PLANNER_MODEL=claude-opus-4-8
REDCELL_JUDGE_MODEL=claude-sonnet-5
REDCELL_TARGET_MODEL=claude-haiku-4-5
REDCELL_MUTATOR_MODEL=Qwen/Qwen3-8B
# SLM endpoint (OpenAI-compatible: vLLM / Groq / Together / Ollama)
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_API_KEY=ollama

# --- infra ---
DATABASE_URL=postgresql://redcell:redcell@localhost:5432/redcell

# --- observability: LangSmith (auto-instruments LangGraph) ---
# Set these and the coordinator graph traces itself; @traced adds spans to the
# RLVR loop + verifier too. KEEP THE KEY HERE, never in code or screenshots.
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=              # lsv2_... (rotate if it ever leaks)
LANGSMITH_PROJECT=redcell

# --- observability: Langfuse (alternative, OTLP-native) ---
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# --- safety ---
REDCELL_EGRESS_POLICY=locked        # TAG denies any run unless this is 'locked'
REDCELL_SCOPE_FILE=scope.lock.yaml
